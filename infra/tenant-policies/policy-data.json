{
  "customPolicies": [
    {
      "name": "VirtualMachine_SKU_Deny",
      "properties": {
        "description": "Deny the Azure Virtual Machines and Virtual Machine Scaleset Deployments with H Series (H, HBv2, HBv3, HBv4) size SKUs",
        "displayName": "Block VM SKU Sizes",
        "metadata": {
          "Version": "20261008-1",
          "category": "Compute"
        },
        "mode": "All",
        "parameters": {
          "BlockedSKUs": {
            "metadata": {
              "description": "The list of VM SKUs to block",
              "displayName": "Blocked skus"
            },
            "type": "Array"
          }
        },
        "policyRule": {
          "if": {
            "AllOf": [
              {
                "AnyOf": [
                  {
                    "field": "type",
                    "in": [
                      "Microsoft.Compute/virtualMachines"
                    ]
                  },
                  {
                    "field": "type",
                    "in": [
                      "Microsoft.Compute/virtualMachineScaleSets"
                    ]
                  }
                ]
              },
              {
                "anyOf": [
                  {
                    "AllOf": [
                      {
                        "field": "Microsoft.Compute/virtualMachines/sku.name",
                        "in": "[parameters('BlockedSKUs')]"
                      },
                      {
                        "field": "Microsoft.Compute/virtualMachines/priority",
                        "notEquals": "Spot"
                      }
                    ]
                  },
                  {
                    "AllOf": [
                      {
                        "field": "Microsoft.Compute/virtualMachineScaleSets/sku.name",
                        "in": "[parameters('BlockedSKUs')]"
                      },
                      {
                        "field": "Microsoft.Compute/virtualMachineScaleSets/virtualMachineProfile.priority",
                        "notEquals": "Spot"
                      }
                    ]
                  }
                ]
              }
            ]
          },
          "then": {
            "effect": "Deny"
          }
        },
        "policyType": "Custom",
        "version": "1.0.0"
      }
    },
    {
      "name": "AKS_LimitNodeCount_Deny",
      "properties": {
        "description": "Require a single named AKS node pool with at most three configured nodes and an autoscaling maximum of three. Block automatic node provisioning and VirtualMachines pools.",
        "displayName": "Limit AKS to one node pool and three nodes",
        "metadata": {
          "Version": "20261008-1",
          "category": "Compute"
        },
        "mode": "All",
        "parameters": {
          "AllowedNodePoolName": {
            "type": "String",
            "defaultValue": "nodepool1",
            "metadata": {
              "description": "The only permitted node pool name. A fixed name prevents additional pools through child-resource requests.",
              "displayName": "Allowed node pool name"
            }
          }
        },
        "policyRule": {
          "if": {
            "anyOf": [
              {
                "allOf": [
                  {
                    "field": "type",
                    "equals": "Microsoft.ContainerService/managedClusters"
                  },
                  {
                    "anyOf": [
                      {
                        "field": "Microsoft.ContainerService/managedClusters/sku.name",
                        "equals": "Automatic"
                      },
                      {
                        "field": "Microsoft.ContainerService/managedClusters/nodeProvisioningProfile.mode",
                        "equals": "Auto"
                      },
                      {
                        "count": {
                          "field": "Microsoft.ContainerService/managedClusters/agentPoolProfiles[*]"
                        },
                        "greater": 1
                      },
                      {
                        "count": {
                          "field": "Microsoft.ContainerService/managedClusters/agentPoolProfiles[*]",
                          "where": {
                            "anyOf": [
                              {
                                "field": "Microsoft.ContainerService/managedClusters/agentPoolProfiles[*].name",
                                "notEquals": "[parameters('AllowedNodePoolName')]"
                              },
                              {
                                "field": "Microsoft.ContainerService/managedClusters/agentPoolProfiles[*].type",
                                "equals": "VirtualMachines"
                              },
                              {
                                "field": "Microsoft.ContainerService/managedClusters/agentPoolProfiles[*].count",
                                "greater": 3
                              },
                              {
                                "allOf": [
                                  {
                                    "field": "Microsoft.ContainerService/managedClusters/agentPoolProfiles[*].enableAutoScaling",
                                    "equals": true
                                  },
                                  {
                                    "field": "Microsoft.ContainerService/managedClusters/agentPoolProfiles[*].maxCount",
                                    "greater": 3
                                  }
                                ]
                              }
                            ]
                          }
                        },
                        "greater": 0
                      }
                    ]
                  }
                ]
              },
              {
                "allOf": [
                  {
                    "field": "type",
                    "equals": "Microsoft.ContainerService/managedClusters/agentPools"
                  },
                  {
                    "anyOf": [
                      {
                        "field": "name",
                        "notEquals": "[parameters('AllowedNodePoolName')]"
                      },
                      {
                        "field": "Microsoft.ContainerService/managedClusters/agentPools/type",
                        "equals": "VirtualMachines"
                      },
                      {
                        "field": "Microsoft.ContainerService/managedClusters/agentPools/count",
                        "greater": 3
                      },
                      {
                        "allOf": [
                          {
                            "field": "Microsoft.ContainerService/managedClusters/agentPools/enableAutoScaling",
                            "equals": true
                          },
                          {
                            "field": "Microsoft.ContainerService/managedClusters/agentPools/maxCount",
                            "greater": 3
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          },
          "then": {
            "effect": "Deny"
          }
        },
        "policyType": "Custom",
        "version": "1.0.0"
      }
    },
    {
      "name": "VMSS_LimitNodesCount_Deny",
      "properties": {
        "description": "Deny the Azure Virtual Machine Scale set Deployments with instance count greater than 3",
        "displayName": "Deny VMSS deployment with instance count greater than 3",
        "metadata": {
          "Version": "20261008-1",
          "category": "Compute"
        },
        "mode": "All",
        "parameters": {},
        "policyRule": {
          "if": {
            "AllOf": [
              {
                "equals": "Microsoft.Compute/virtualMachineScaleSets",
                "field": "type"
              },
              {
                "exists": true,
                "field": "Microsoft.Compute/virtualMachineScaleSets/sku.capacity"
              },
              {
                "field": "Microsoft.Compute/virtualMachineScaleSets/sku.capacity",
                "notEquals": ""
              },
              {
                "greater": 3,
                "value": "[int(if(empty(string(field('Microsoft.Compute/virtualMachineScaleSets/sku.capacity'))), '0', string(field('Microsoft.Compute/virtualMachineScaleSets/sku.capacity'))))]"
              }
            ]
          },
          "then": {
            "effect": "Deny"
          }
        },
        "policyType": "Custom",
        "version": "1.0.0"
      }
    },
    {
      "name": "AzureOpenAI_ProvisionedCapacity_Deny",
      "properties": {
        "description": "Deny the Azure OpenAI Deployments with Provisioned Capacity",
        "displayName": "Block Azure OpenAI Provisioned Capacity",
        "metadata": {
          "Version": "20261008-1",
          "category": "Cognitive Services"
        },
        "mode": "All",
        "parameters": {},
        "policyRule": {
          "if": {
            "AllOf": [
              {
                "equals": "Microsoft.CognitiveServices/accounts/deployments",
                "field": "type"
              },
              {
                "field": "Microsoft.CognitiveServices/accounts/deployments/sku.name",
                "in": [
                  "ProvisionedManaged",
                  "GlobalProvisionedManaged",
                  "DataZoneProvisionedManaged"
                ]
              }
            ]
          },
          "then": {
            "effect": "Deny"
          }
        },
        "policyType": "Custom",
        "version": "1.0.0"
      }
    },
    {
      "name": "Sentinel_Commitment_Deny",
      "properties": {
        "description": "Deny the Azure Sentinel Deployments with Commitment over 100",
        "displayName": "Block Azure Sentinel Commitment over 100",
        "metadata": {
          "Version": "20261008-1",
          "category": "Monitoring"
        },
        "mode": "All",
        "parameters": {},
        "policyRule": {
          "if": {
            "AllOf": [
              {
                "equals": "Microsoft.OperationalInsights/workspaces",
                "field": "type"
              },
              {
                "field": "Microsoft.OperationalInsights/workspaces/sku.capacityReservationLevel",
                "greater": 100
              }
            ]
          },
          "then": {
            "effect": "Deny"
          }
        },
        "policyType": "Custom",
        "version": "1.0.0"
      }
    },
    {
      "name": "KeyVaultManagedHSM_PurgeProtectionEnabled_Deny",
      "properties": {
        "description": "Deny Azure Key Vault Managed HSM with Purge Protection Enabled",
        "displayName": "Deny Azure Key Vault Managed HSM with Purge Protection Enabled",
        "metadata": {
          "Version": "20261008-1",
          "category": "Key Vault"
        },
        "mode": "All",
        "parameters": {
          "AllowedTagName": {
            "defaultValue": "CostControl",
            "metadata": {
              "description": "Name of the tag, such as 'CostControl'",
              "displayName": "Tag Name"
            },
            "type": "String"
          },
          "AllowedTagValue": {
            "defaultValue": "Ignore",
            "metadata": {
              "description": "Value of the tag, such as 'Ignore'",
              "displayName": "Tag Value"
            },
            "type": "String"
          }
        },
        "policyRule": {
          "if": {
            "AllOf": [
              {
                "equals": "Microsoft.KeyVault/managedHSMs",
                "field": "type"
              },
              {
                "Equals": "true",
                "field": "Microsoft.KeyVault/managedHsms/enablePurgeProtection"
              },
              {
                "not": {
                  "AnyOf": [
                    {
                      "equals": "[parameters('AllowedTagValue')]",
                      "field": "[concat('tags[', parameters('AllowedTagName'), ']')]"
                    },
                    {
                      "equals": "[parameters('AllowedTagValue')]",
                      "value": "[resourceGroup().tags[parameters('AllowedTagName')]]"
                    }
                  ]
                }
              }
            ]
          },
          "then": {
            "effect": "Deny"
          }
        },
        "policyType": "Custom",
        "version": "1.0.0"
      }
    }
  ],

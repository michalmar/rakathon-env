subscription_id = "00000000-0000-0000-0000-000000000000"
location        = "swedencentral"

resource_group_name      = "rg-rakathon-shared"
project_name_compact     = "rakathon"
account_replication_type = "LRS"
storage_use_azuread       = true
shared_access_key_enabled = false

# Prázdný seznam ponechá veřejný endpoint dostupný ze všech sítí.
# Pro omezení přidejte veřejné IP rozsahy účastníků a lokálního správce.
allowed_ip_ranges = []

# Microsoft Entra object ID. Mohou zůstat prázdné do předání identit.
customer_data_contributor_object_ids = []
team_data_reader_object_ids          = []

foundry_project_name = "rakathon-project"

# Ověřeno pro Sweden Central dne 2026-10-07.
# Kapacita 3333 je aktuální maximum subscription quota i platform capacity.
foundry_model_deployments = {
  gpt-6-1-sol-dz-eu = {
    model_name    = "gpt-6.1-sol"
    model_version = "2026-09-29"
    sku_name      = "DataZoneStandard"
    capacity      = 3333
  }
  gpt-6-luna-dz-eu = {
    model_name    = "gpt-6-luna"
    model_version = "2026-09-22"
    sku_name      = "DataZoneStandard"
    capacity      = 3333
  }
}

tags = {
  environment = "hackathon"
  managed-by  = "terraform"
  scope       = "shared"
}
